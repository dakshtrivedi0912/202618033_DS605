   "source": [
    "## Part A - Scikit-learn Implementation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "c9fad200",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
